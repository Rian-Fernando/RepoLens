# GitHub API access is OFF by default. Set to true only when you want live
# analysis of new profiles. Even then, nothing contacts GitHub without a token:
# a signed-in visitor's own (below), or GITHUB_TOKEN if you set one.
# GITHUB_API_ENABLED=true

# "Sign in with GitHub" for live analysis: a GitHub App with NO permissions.
# github.com -> Settings -> Developer settings -> GitHub Apps -> New GitHub App
#   Homepage URL:   https://repolens.rianfernando.com
#   Callback URLs:  https://repolens.rianfernando.com/api/auth/callback
#                   http://localhost:3000/api/auth/callback   (local preview)
#   Expire user authorization tokens: on  ·  Webhook "Active": off
#   Permissions: none  ·  Where can it be installed: Any account
# Then copy the Client ID and generate a client secret. Each analysis runs on
# the signed-in visitor's own GitHub rate limit.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---- All optional. The app runs 100% free with nothing set. ----

# AI-written suggestions + README drafts (Gemini free tier: ~1,500 requests/day, no card).
# Get a free key at https://aistudio.google.com/apikey — without it, the built-in
# rules engine generates the suggestions instead.
# GEMINI_API_KEY=

# Optional model override (defaults to gemini-flash-latest, falls back to gemini-flash-lite-latest)
# GEMINI_MODEL=

# NOT RECOMMENDED: a server-wide token that lets signed-out visitors start live
# analyses too. It ties all that traffic to whoever owns the token. Leave unset
# and use the GitHub App above instead.
# GITHUB_TOKEN=

# Only applies if GITHUB_TOKEN is set: fresh analyses per hour on it
# (default 20, about 17% of a 5,000/hour token).
# GITHUB_HOURLY_ANALYSES=20

# Score database (free Neon Postgres: https://neon.tech — copy the connection string).
# Optional: without it the leaderboard shows a setup notice, percentiles stay
# estimated, and no score history is kept. With it, all three go live.
# DATABASE_URL=

# One-click fix pull requests stay off. Turning them on needs the GitHub App to
# have Contents + Pull requests write access, installed on the visitor's repo.
# FIX_PRS_ENABLED=true

# Watch mode (optional): weekly re-score + email on change.
# RESEND_API_KEY from https://resend.com (free: 100 emails/day).
# CRON_SECRET: any random string; Vercel sends it as the cron Authorization header.
# RESEND_API_KEY=
# RESEND_FROM="RepoLens <onboarding@resend.dev>"
# CRON_SECRET=

# Feedback widget (optional). The public project key from your Feedex
# workspace — https://feedex.rianfernando.com → Projects → Install tab.
# Publishable and safe in client HTML. Unset = no widget renders.
# NEXT_PUBLIC_FEEDEX_KEY=pk_fdx_...

# Where the "back to portfolio" links point (defaults to https://rianfernando.com).
NEXT_PUBLIC_PORTFOLIO_URL=https://rianfernando.com
