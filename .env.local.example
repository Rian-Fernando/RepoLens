# GitHub API access is OFF by default. Set to true ONLY when you intend the
# app to contact api.github.com again (profile analysis, badges, score API,
# OG cards, the weekly watch cron and Fix PRs all depend on it).
# GITHUB_API_ENABLED=true

# ---- All optional. The app runs 100% free with nothing set. ----

# AI-written suggestions + README drafts (Gemini free tier: ~1,500 requests/day, no card).
# Get a free key at https://aistudio.google.com/apikey — without it, the built-in
# rules engine generates the suggestions instead.
# GEMINI_API_KEY=

# Optional model override (defaults to gemini-flash-latest, falls back to gemini-flash-lite-latest)
# GEMINI_MODEL=

# Server-side GitHub token for live analyses (public data only — a fine-grained
# token with no extra permissions is enough). Only used when GITHUB_API_ENABLED
# is true. Requests are serial, capped per visitor and per hour, and stop at the
# first rate-limit signal. Preferred long-term: a GitHub App instead of a
# personal token, so the app's traffic isn't tied to a personal account.
# GITHUB_TOKEN=

# Fresh analyses per hour allowed on the shared quota (default 20 ≈ 17% of a
# 5,000/hour token). Visitors' own pasted tokens don't count toward it.
# GITHUB_HOURLY_ANALYSES=20

# Score database (free Neon Postgres: https://neon.tech — copy the connection string).
# Optional: without it the leaderboard shows a setup notice, percentiles stay
# estimated, and no score history is kept. With it, all three go live.
# DATABASE_URL=

# One-click Fix PRs (optional). Create a GitHub OAuth App:
# github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage:     https://repolens.rianfernando.com
#   Callback URL: https://repolens.rianfernando.com/api/auth/callback
# Without these, the "Open as PR" button simply doesn't appear.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Watch mode (optional): weekly re-score + email on change.
# RESEND_API_KEY from https://resend.com (free: 100 emails/day).
# CRON_SECRET: any random string; Vercel sends it as the cron Authorization header.
# RESEND_API_KEY=
# RESEND_FROM="RepoLens <onboarding@resend.dev>"
# CRON_SECRET=

# Error monitoring (optional). Create a Next.js project at https://sentry.io
# (free tier), copy its DSN into both vars, redeploy. Inert when unset.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Feedback widget (optional). The public project key from your Feedex
# workspace — https://feedex.rianfernando.com → Projects → Install tab.
# Publishable and safe in client HTML. Unset = no widget renders.
# NEXT_PUBLIC_FEEDEX_KEY=pk_fdx_...

# Where the "back to portfolio" links point (defaults to https://rianfernando.com).
NEXT_PUBLIC_PORTFOLIO_URL=https://rianfernando.com
